Options -Indexes
DirectoryIndex index.php

<IfModule mod_authz_core.c>
    <FilesMatch "^(?:\..*|env|composer\.(?:json|lock)|README.*|LICENSE|spark|preload\.php|phpunit.*)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never expose application code, credentials, dependencies or runtime data.
    RewriteRule ^(?:\.|app(?:/|$)|system(?:/|$)|vendor(?:/|$)|writable(?:/|$)|tests(?:/|$)|deployment(?:/|$)) - [F,L,NC]

    # Serve only public assets; do not allow PHP execution through this path.
    RewriteRule ^(?:public/)?assets/.*\.(?:php[0-9]?|phtml|phar)(?:/|$) - [F,L,NC]
    RewriteRule ^assets/(.*)$ public/assets/$1 [L]
    RewriteRule ^(favicon\.ico|robots\.txt)$ public/$1 [L]
    RewriteRule ^public/(?:assets/|favicon\.ico$|robots\.txt$) - [L]
    RewriteRule ^public(?:/|$) - [F,L,NC]

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteRule ^index\.php(?:/|$) - [L]
    RewriteRule ^(.*)$ index.php/$1 [L,QSA]
</IfModule>
