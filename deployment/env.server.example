# Both profiles live here. Change only CI_ENVIRONMENT to select the deployment.
# development = local php spark serve; production = hosted test server.
# testing = automated tests (database.tests), not the hosted test server.
CI_ENVIRONMENT = production

app.indexPage = ''
app.appTimezone = 'Asia/Kolkata'
app.localBaseURL = 'http://localhost:8080/'
app.localForceHTTPS = false
app.serverBaseURL = 'https://sabjiwalah.site.je/'
app.serverForceHTTPS = true

